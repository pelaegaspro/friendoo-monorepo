{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "redirects": [
    {
      "source": "/admin",
      "destination": "https://friendoo-admin.vercel.app",
      "permanent": false
    },
    {
      "source": "/admin/(.*)",
      "destination": "https://friendoo-admin.vercel.app/$1",
      "permanent": false
    },
    {
      "source": "/crm",
      "destination": "https://friendoo-crm.vercel.app",
      "permanent": false
    },
    {
      "source": "/crm/(.*)",
      "destination": "https://friendoo-crm.vercel.app/$1",
      "permanent": false
    }
  ],
  "headers": [
    {
      "source": "/admin(.*)",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, nofollow" }
      ]
    },
    {
      "source": "/crm(.*)",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, nofollow" }
      ]
    }
  ],
  "rewrites": [
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
