{
  "name": "functions",
  "description": "Cloud Functions for Friendoo",
  "scripts": {
    "build": "tsc",
    "serve": "firebase serve --only functions",
    "shell": "firebase functions:shell",
    "start": "npm run shell",
    "predeploy": "npm run build",
    "deploy": "firebase deploy --only functions",
    "deploy:payments": "node scripts/deploy-payments.cjs",
    "deploy:createCashfreeOrder": "node scripts/deploy-payments.cjs createCashfreeOrder",
    "deploy:calls": "node scripts/deploy-calls.cjs",
    "logs": "firebase functions:log"
  },
  "engines": {
    "node": "20"
  },
  "main": "lib/index.js",
  "dependencies": {
    "@google-cloud/tasks": "^6.2.2",
    "agora-token": "^2.0.3",
    "axios": "^1.6.0",
    "express": "^4.22.2",
    "firebase-admin": "^13.10.0",
    "firebase-functions": "^7.2.5",
    "googleapis": "^140.0.0",
    "nodemailer": "^8.0.7"
  },
  "devDependencies": {
    "firebase-functions-test": "^3.0.0",
    "typescript": "^5.2.2"
  },
  "private": true
}
