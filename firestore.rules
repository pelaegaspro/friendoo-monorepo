rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isSelf(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function isCallParticipant() {
      return isSignedIn() && (
        request.auth.uid == resource.data.callerId
        || request.auth.uid == resource.data.hostId
        || request.auth.uid == resource.data.fromUserId
        || request.auth.uid == resource.data.toUserId
        || request.auth.uid == resource.data.receiverId
      );
    }

    // ── Users: self profile, NO coin/role escalation ─────────────────────
    match /users/{uid} {
      allow read: if isSignedIn();
      allow create: if isSelf(uid)
        && request.resource.data.get('isHost', false) == false
        && request.resource.data.get('role', 'user') == 'user';
      allow update: if isSelf(uid)
        && !request.resource.data.diff(resource.data).affectedKeys()
          .hasAny([
            'coinBalance', 'coins', 'walletFrozen', 'walletFrozenReason', 'walletFrozenAt',
            'isHost', 'role', 'totalCoinsEarned', 'totalCoinsSpent', 'earnings',
            'totalEarningsInr', 'availableForWithdrawal', 'payoutStatus'
          ])
        && (
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['onboardingCompleted'])
          || resource.data.get('onboardingCompleted', false) == false
          || request.resource.data.onboardingCompleted == true
        );
      allow delete: if false;
    }

    // ── Hosts: public read, NO client write (admin Functions only) ─────────
    match /hosts/{hostId} {
      allow read: if true;
      allow create, update, delete: if false;

      match /ratings/{ratingId} {
        allow create: if isSignedIn();
        allow read, update, delete: if false;
      }

      match /payoutHistory/{payoutId} {
        allow read: if isSelf(hostId);
        allow write: if false;
      }
    }

    // ── Presence: read signed-in, write SERVER ONLY ────────────────────────
    match /presence/{uid} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    // ── Calls: participants read only, write SERVER ONLY ─────────────────
    match /calls/{callId} {
      allow read: if isCallParticipant();
      allow create, update, delete: if false;
    }

    match /call_logs/{logId} {
      allow read, write: if false;
    }

    match /hostApplications/{docId} {
      allow create: if request.resource.data.keys().hasAll(['phoneNumber', 'submittedAt'])
        && request.resource.data.phoneNumber is string
        && request.resource.data.phoneNumber.size() >= 10;
      allow read, update, delete: if false;
    }

    match /reports/{reportId} {
      allow create: if isSignedIn()
        && request.resource.data.reporterId == request.auth.uid;
      allow read, update, delete: if false;
    }

    match /anonymousAnalytics/{docId} {
      allow create: if isSignedIn();
      allow read, update, delete: if false;
    }

    match /transactions/{txId} {
      allow read, write: if false;
    }

    match /chats/{chatId} {
      allow read: if isSignedIn() && (request.auth.uid in resource.data.participants);
      allow create: if isSignedIn() && (request.auth.uid in request.resource.data.participants);
      allow update: if isSignedIn() && (request.auth.uid in resource.data.participants);
      allow delete: if false;

      match /messages/{messageId} {
        allow read: if isSignedIn()
          && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants;
        allow create: if isSignedIn()
          && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants
          && request.resource.data.senderId == request.auth.uid;
        allow update, delete: if false;
      }
    }

    match /coinPackages/{packageId} {
      allow read: if true;
      allow write: if false;
    }

    match /coinTransactions/{txId} {
      allow read: if isSignedIn() && request.auth.uid == resource.data.userId;
      allow create, update, delete: if false;
    }

    match /fraudAlerts/{alertId} {
      allow read, write: if false;
    }

    match /activeBillingJobs/{jobId} {
      allow read, write: if false;
    }

    match /config/{docId} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    match /admins/{adminId} {
      allow read: if isSelf(adminId);
      allow write: if false;
    }

    match /withdrawalRequests/{id} {
      allow read: if isSignedIn() && request.auth.uid == resource.data.hostId;
      allow create, update, delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
