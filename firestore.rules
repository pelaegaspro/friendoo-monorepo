rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    match /users/{uid} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.auth.uid == uid;
      allow update: if request.auth != null
        && request.auth.uid == uid
        && !request.resource.data.diff(resource.data).affectedKeys()
          .hasAny(['coinBalance', 'coins', 'walletFrozen', 'walletFrozenReason', 'walletFrozenAt']);
      allow delete: if false;

      // Subcollections (notifications, etc)
      match /{allSubcollections=**} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }
    }

    // Hosts: public read, write restricted to admin/functions
    // Each host has a document here with the SAME uid as their users/{uid} document
    match /hosts/{hostId} {
      allow read: if true;
      allow create: if request.auth != null && request.auth.uid == hostId;
      allow update: if request.auth != null
        && request.auth.uid == hostId
        && !request.resource.data.diff(resource.data).affectedKeys()
          .hasAny(['earnings', 'totalEarningsInr', 'availableForWithdrawal', 'payoutStatus']);
      allow delete: if false;

      // Ratings: users can only write (add), no direct read
      match /ratings/{ratingId} {
        allow create: if request.auth != null;
        allow read: if false;
      }

      // Payout history: host can only see their own (same UID)
      match /payoutHistory/{payoutId} {
        allow read: if request.auth != null && request.auth.uid == hostId;
        allow write: if false;
      }
    }

    // Host applications: allow anyone (no auth) to submit from the landing page
    match /hostApplications/{docId} {
      allow create: if true;
      allow read, update, delete: if false;
    }

    // Reports: users can only create, no reading back
    match /reports/{reportId} {
      allow create: if request.auth != null;
      allow read: if false; // Only for admin (handled via server-side SDK)
    }

    // Analytics: write-only for users
    match /anonymousAnalytics/{docId} {
      allow create: if request.auth != null;
      allow read: if false;
    }

    // Transactions & Billing: completely locked from client
    match /transactions/{txId} {
      allow read, write: if false;
    }

    match /calls/{callId} {
      allow read: if request.auth != null && (request.auth.uid == resource.data.fromUserId || request.auth.uid == resource.data.hostId);
      allow create: if request.auth != null;
      allow update: if request.auth != null && (request.auth.uid == resource.data.fromUserId || request.auth.uid == resource.data.hostId);
    }

    match /chats/{chatId} {
      allow read: if request.auth != null && (request.auth.uid in resource.data.participants);
      allow write: if request.auth != null && (request.auth.uid in request.resource.data.participants);

      match /messages/{messageId} {
        allow read, write: if request.auth != null;
      }
    }

    match /coinPackages/{packageId} {
      allow read: if true;
      allow write: if false; // Admin-only via Firebase Console
    }

    match /coinTransactions/{txId} {
      allow read: if request.auth != null && request.auth.uid == resource.data.userId;
      allow create: if false; // Created by Cloud Functions only
      allow update: if false; // Updated by Cloud Functions only
    }

    // Fraud alerts: completely locked from client (admin-only via server SDK)
    match /fraudAlerts/{alertId} {
      allow read, write: if false;
    }
  }
}
